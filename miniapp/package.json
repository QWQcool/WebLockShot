{
  "name": "weblockshot-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "WEB锁镜 小程序轻端（Taro 4 + React 18，weapp 目标）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch"
