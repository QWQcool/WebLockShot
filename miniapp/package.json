    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.1.7",
    "@tarojs/helper": "4.1.7",
    "@tarojs/plugin-framework-react": "4.1.7",
    "@tarojs/plugin-platform-weapp": "4.1.7",
    "@tarojs/react": "4.1.7",
    "@tarojs/runtime": "4.1.7",
    "@tarojs/shared": "4.1.7",
    "@tarojs/taro": "4.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.1.7",
    "@tarojs/webpack5-runner": "4.1.7",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.1.7",
    "typescript": "^5.5.4",
    "webpack": "5.91.0",
    "webpack-chain": "^6.5.1"
  }
